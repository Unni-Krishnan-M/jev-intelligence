# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Docker Compose -------------------------------------------------------------
POSTGRES_USER=jev
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jev
API_PORT=8000
WEB_PORT=3000

# --- API (all JEV_* vars are read by backend/jev_api/config.py) -----------------
JEV_ENV=development                 # production disables /docs and requires JEV_JWT_SECRET
JEV_JWT_SECRET=change-me-to-a-long-random-string
JEV_JWT_EXPIRE_MINUTES=1440
# Local runs without Docker default to SQLite (./jev.db) and in-memory cache:
# JEV_DATABASE_URL=postgresql+psycopg://jev:change-me@localhost:5432/jev
# JEV_REDIS_URL=redis://localhost:6379/0
JEV_CORS_ORIGINS=http://localhost:3000
JEV_COOKIE_SECURE=false             # true behind HTTPS
JEV_RATE_LIMIT_PER_MINUTE=240
JEV_AUTH_RATE_LIMIT_PER_MINUTE=20
# Optional bootstrap admin (created/promoted on API startup)
JEV_ADMIN_EMAIL=admin@example.com
JEV_ADMIN_PASSWORD=change-me-admin

# --- Frontend -------------------------------------------------------------------
# Where Next.js proxies /api/* (local dev default: http://127.0.0.1:8000)
JEV_API_URL=http://127.0.0.1:8000
